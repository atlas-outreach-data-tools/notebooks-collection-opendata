    "# Define the base plot, binning, and range\n",
    "def plot_mass_distribution(\n",
    "    full_mass_list,\n",
    "    x_axis_label,\n",
    "    plot_title,\n",
    "    comparison_mass_list=None,\n",
    "):\n",
    "    bin_width = 1  # GeV\n",
    "\n",
    "    bin_edges = np.arange(\n",
    "        start=100,\n",
    "        stop=161,\n",
    "        step=bin_width,\n",
    "    )\n",
    "\n",
    "    bin_centres = (\n",
    "        bin_edges[:-1] + bin_edges[1:]\n",
    "    ) / 2\n",
    "\n",
    "    # Histogram the main distribution.\n",
    "    event_counts, _ = np.histogram(\n",
    "        ak.to_numpy(full_mass_list),\n",
    "        bins=bin_edges,\n",
    "    )\n",
    "\n",
    "    event_count_errors = np.sqrt(event_counts)\n",
    "\n",
    "    fig, main_axes = plt.subplots(figsize=(8, 6))\n",
    "\n",
    "    main_axes.errorbar(\n",
    "        x=bin_centres,\n",
    "        y=event_counts,\n",
    "        yerr=event_count_errors,\n",
    "        fmt=\"ko\",\n",
    "        label=r\"Diphoton candidates, $m_{\\gamma\\gamma}$\",\n",
    "    )\n",
    "\n",
    "    # Add the electron-photon distribution when one is supplied.\n",
    "    if comparison_mass_list is not None:\n",
    "        comparison_counts, _ = np.histogram(\n",
    "            ak.to_numpy(comparison_mass_list),\n",
    "            bins=bin_edges,\n",
